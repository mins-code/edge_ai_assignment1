{
  "name": "Edge AI Assignment 1 - Battery API",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "python -m pip install -r edge_ai_assignment1/requirements.txt pyserial",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "battery-api", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter"] }
  }
}
